# 复制为 .env 后再修改，.env 不要提交到仓库。
# 密码建议只用字母和数字，避免 URL / DSN 转义问题。

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
# 宿主机回环地址上的 MySQL 端口，仅用于 SSH 隧道 / 本机客户端访问。
# 宿主机 3306 已被占用时改成 3307（隧道和客户端端口同步修改）。
MYSQL_HOST_PORT=3306

# Redis（当前不使用密码；留空即可）
REDIS_PASSWORD=

# JWT 签名密钥，至少 32 字节。生成：openssl rand -hex 32
JWT_SECRET=change-me-please-use-openssl-rand-hex-32

# 素材完整 URL 的前缀，改成服务器公网 IP 或域名（走统一 Nginx 网关的 80 端口）。
# 浏览器会直接访问这个地址加载素材，必须能从外部打开。
UPLOAD_PUBLIC_BASE_URL=http://203.0.113.10

# 配置 HTTPS 后改为 true（同时建议把 Cookie Secure、SameSite 一起调整）。
JWT_COOKIE_SECURE=false

# 对外端口：正式访问统一走 HTTP_PORT（Nginx 网关）。
# FRONTEND_PORT / BACKEND_PORT 保留用于直接调试，可只在内网开放。
HTTP_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8888

# 日志级别与服务器时区
LOG_LEVEL=info
TZ=Asia/Shanghai

# 监控（Grafana 管理员密码，启用 `docker compose --profile jk up -d` 前必须设置）
# 通过 SSH 隧道访问 Grafana：ssh -L 3001:127.0.0.1:3001 用户名@服务器IP
GRAFANA_PASSWORD=change-me-grafana
