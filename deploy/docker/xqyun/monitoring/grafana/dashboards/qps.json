{
  "uid": "xqyun-qps",
  "title": "小鹊云 · 接口 QPS",
  "description": "Go 后端按路由统计的 QPS 与业务成功/失败量。数据来源：Prometheus 抓取 backend:8888/metrics。",
  "tags": ["xqyun", "qps"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "全站 QPS",
      "description": "所有接口每秒请求数之和，不区分成功失败。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(xqyun_http_requests_total[1m]))",
          "legendFormat": "全站",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "各接口 QPS（堆叠）",
      "description": "按路由分组。route 使用路由模板（如 /api/v1/admin/submissions/:id），不会按具体 ID 拆开。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route) (rate(xqyun_http_requests_total[1m]))",
          "legendFormat": "{{route}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "业务成功 / 失败 QPS",
      "description": "按统一响应的业务码分组：0 = 成功，40100 = 未登录/令牌无效，40000 = 参数错误，40400 = 不存在，50000 = 服务端错误。HTTP 状态恒为 200，业务结果只看这里。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (code) (rate(xqyun_business_responses_total[1m]))",
          "legendFormat": "业务码 {{code}}",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
